# ---------------------------------------------------------------------------
# Backend environment template.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# `.env.example` contains placeholders only.
# ---------------------------------------------------------------------------

# Server
PORT=8000
NODE_ENV=development

# Database (MongoDB)
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<cluster>
MONGO_NAME=myportfolio

# --- CORS -------------------------------------------------------------------
# Comma separated list of allowed browser origins (frontend).
# Do NOT use a wildcard together with credentials.
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example.com
CLIENT_URL=http://localhost:5173,https://your-frontend.example.com

# --- JWT (access tokens) ----------------------------------------------------
# REQUIRED. At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# REQUIRED. Values must match the issuer/audience embedded in every token.
JWT_ISSUER=portfolio-backend
JWT_AUDIENCE=portfolio-admin
# Short lived access token (kept only in frontend memory).
JWT_ACCESS_EXPIRES_IN=15m

# Deprecated - ignored. Kept only so old deployments do not crash on startup.
JWT_SECRET=

# --- Refresh tokens ---------------------------------------------------------
# Days before an HTTP-only refresh cookie expires (integer 1-30).
REFRESH_TOKEN_TTL_DAYS=7
# Milliseconds during which the immediately-preceding rotated token is treated
# as a benign concurrent refresh instead of confirmed reuse.
REFRESH_RACE_GRACE_MS=10000

# --- Cookies ----------------------------------------------------------------
# Must be "true" when COOKIE_SAME_SITE=none (cross-site deployments).
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# --- One-time admin bootstrap ----------------------------------------------
# Backend-only secret sent as the `X-Admin-Bootstrap-Secret` header to
# POST /api/v1/admin/bootstrap. Required only until the first admin exists.
# NEVER expose this value to the frontend / Vite variables.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_BOOTSTRAP_SECRET=

# --- Password hashing -------------------------------------------------------
# bcrypt cost for NEW hashes (integer 10-15). Existing hashes keep their cost.
BCRYPT_ROUNDS=12

# --- Rate limiting (optional overrides) ------------------------------------
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
BOOTSTRAP_RATE_LIMIT_MAX=5
BOOTSTRAP_RATE_LIMIT_WINDOW_MS=3600000
REFRESH_RATE_LIMIT_MAX=60
REFRESH_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RATE_LIMIT_MAX=5
PASSWORD_RATE_LIMIT_WINDOW_MS=900000
ADMIN_CREATE_RATE_LIMIT_MAX=10
ADMIN_CREATE_RATE_LIMIT_WINDOW_MS=3600000
OTP_RATE_LIMIT_MAX=8
OTP_RATE_LIMIT_WINDOW_MS=900000
# Set to "true" ONLY in automated tests.
RATE_LIMIT_DISABLED=false

# --- Existing integrations (unchanged) -------------------------------------
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
CLOUDINARY_URL=

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
